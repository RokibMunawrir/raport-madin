---
import Layout from "../../../layouts/Layout.astro";
import TeacherManagement from "../../../components/data/teachers";
import { addTeacher, updateTeacher, deleteTeacher } from "../../../db/queries/teachers";
import { db } from "../../../db";
import { teachers } from "../../../db/schema";
import { count, eq, like, and, desc, asc, or } from "drizzle-orm";
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const sessionUser = user as any;


// 1. Get Query Parameters
const url = new URL(Astro.url);
const page = parseInt(url.searchParams.get("page") || "1");
const limit = 10;
const offset = (page - 1) * limit;

const search = url.searchParams.get("search") || "";
const statusFilter = url.searchParams.get("status") || "All";
const sortBy = url.searchParams.get("sortBy") || "name";
const sortOrder = url.searchParams.get("sortOrder") || "asc";

// 2. Build Filters
const filters = [];
if (search) {
    filters.push(or(
      like(teachers.name, `%${search}%`),
      like(teachers.nip, `%${search}%`)
    ));
}
if (statusFilter && statusFilter !== 'All') {
    filters.push(eq(teachers.status, statusFilter));
}

const filterQuery = filters.length > 0 ? and(...filters) : undefined;

// 3. Handle POST Actions
if (Astro.request.method === "POST") {
  try {
    const formData = await Astro.request.formData();
    const action = formData.get("_action") as string;
    const id = formData.get("id") as string;
    
    const rawPhone = formData.get("phone") as string;
    const phone = rawPhone ? (rawPhone.startsWith('0') ? '+62' + rawPhone.slice(1) : (rawPhone.startsWith('62') ? '+' + rawPhone : (rawPhone.startsWith('+') ? rawPhone : '+62' + rawPhone))) : "";

    const teacherData = {
      name: formData.get("name")?.toString() || "",
      nip: formData.get("nip")?.toString() || null,
      gender: formData.get("gender")?.toString() || "Laki-laki",
      phone: phone,
      email: formData.get("email")?.toString() || null,
      address: formData.get("address")?.toString() || null,
      province: formData.get("province")?.toString() || null,
      regency: formData.get("regency")?.toString() || null,
      district: formData.get("district")?.toString() || null,
      village: formData.get("village")?.toString() || null,
      birthPlace: formData.get("birthPlace")?.toString() || null,
      birthDate: (formData.get("birthDate")?.toString()) || null,
      status: formData.get("status")?.toString() || "Aktif",
      joinedDate: (formData.get("joinedDate")?.toString()) || null,
    };

    let successStatus = "";

    if (action === "delete" && id) {
      await deleteTeacher(id);
      successStatus = "deleted";
    } else if (action === "edit" && id && teacherData.name) {
      await updateTeacher(id, teacherData);
      successStatus = "updated";
    } else if (action === "add" && teacherData.name) {
      await addTeacher(teacherData);
      successStatus = "added";
    }

    if (successStatus) {
      return Astro.redirect(`/master-data/teachers?toast=${successStatus}`);
    }
  } catch (e: any) {
    console.error("Error processing teacher action:", e);
    return Astro.redirect(`/master-data/teachers?toast=error&message=${encodeURIComponent(e.message || "Terjadi kesalahan sistem")}`);
  }
}

// 4. Fetch Total Count
const totalCountResult = await db
    .select({ total: count() })
    .from(teachers)
    .where(filterQuery);

const totalCount = totalCountResult[0]?.total || 0;
const totalPages = Math.ceil(totalCount / limit);

// 5. Fetch Paginated Teachers
const orderColumn = sortBy === 'nip' ? teachers.nip : teachers.name;

const teachersData = await db
    .select()
    .from(teachers)
    .where(filterQuery)
    .limit(limit)
    .offset(offset)
    .orderBy(sortOrder === 'asc' ? asc(orderColumn) : desc(orderColumn));

// Transform to component's expected structure
const initialData = teachersData.map(t => ({
  id: t.id,
  name: t.name,
  nip: t.nip || '-',
  gender: t.gender || 'Laki-laki',
  phone: t.phone || '-',
  email: t.email || '-',
  address: t.address || '-',
  birthPlace: t.birthPlace || '-',
  birthDate: t.birthDate || '-',
  status: t.status as any || 'Aktif',
  joinedDate: t.joinedDate || '-',
  province: t.province ?? null,
  regency: t.regency ?? null,
  district: t.district ?? null,
  village: t.village ?? null,
  avatar: `https://api.dicebear.com/7.x/initials/svg?seed=${t.name}`
}));
---

<Layout title="Asatidz | Raport MDT Al-Amiriyyah">
  <TeacherManagement 
    initialData={initialData} 
    client:only="react" 
    currentPage={page}
    totalPages={totalPages}
    totalCount={totalCount}
    searchQuery={search}
    statusFilter={statusFilter}
    sortBy={sortBy}
    sortOrder={sortOrder}
    user={sessionUser}
  />

</Layout>
