---
import Layout from "../../../layouts/Layout.astro"
import UserManagement from "../../../components/data/users.tsx"
import { getUsers } from "../../../db/queries/users";
import { getTeachers } from "../../../db/queries/teachers";

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const sessionUser = user as any;


const usersData = await getUsers();
const teachersData = await getTeachers();

const initialData = usersData.map(u => ({
    id: u.id,
    name: u.name,
    username: u.email.split('@')[0], // Fallback username
    email: u.email,
    role: (u.role as any) || 'Guru',
    status: 'Aktif' as const, // Mock status for now
    lastLogin: '-', // Mock
    avatar: u.image || `https://api.dicebear.com/7.x/initials/svg?seed=${u.name}`,
    teacherId: u.teacherId || undefined,
    teacherName: u.teacherName || undefined
}));
---

<Layout title="Manajemen Pengguna Sistem" activeItem="User">
    <UserManagement 
        initialData={initialData} 
        teachers={teachersData}
        user={sessionUser}
        client:only="react" 
    />

</Layout>
