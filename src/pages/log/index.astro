---
import Layout from '../../layouts/Layout.astro';
import SystemLog from '../../components/admin/log';
import { getAllActivityLogs, getActivityLogStats } from '../../db/queries/logs';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const sessionUser = user as any;

const pageParam = Astro.url.searchParams.get("page");
const page = pageParam ? parseInt(pageParam) : 1;
const result = await getAllActivityLogs({ page, limit: 10 });
const stats = await getActivityLogStats();

---

<Layout title="Riwayat Aktivitas | Raport MDT Al-Amiriyyah">
  <SystemLog 
    client:only="react"
    initialLogs={result.logs}
    total={result.total}
    totalPages={result.totalPages}
    currentPage={result.currentPage}
    stats={stats}
    user={sessionUser}
  />

</Layout>
