---
import Layout from "../../layouts/Layout.astro";
import TeacherPresenceManagement from "../../components/admin/presence-teacher";
import { db } from "../../db";
import { classrooms, academicYears } from "../../db/schema";
import { getTeacherAttendanceByDate, saveBulkTeacherAttendance } from "../../db/queries/teacher-attendance";
import { eq } from "drizzle-orm";

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const sessionUser = user as any;

const userRole = sessionUser.role;
const userTeacherId = sessionUser.teacherId;

// 1. Fetch Master Data (Classrooms)
const allClasses = await db.select().from(classrooms)
    .where(userRole === 'Guru' && userTeacherId ? eq(classrooms.teacherId, userTeacherId) : undefined)
    .orderBy(classrooms.name);

const activeYear = await db.select().from(academicYears).where(eq(academicYears.isActive, 1)).limit(1);

// 2. Get Filters from Query Params
const url = new URL(Astro.request.url);
const selectedDate = url.searchParams.get("date") || new Date().toISOString().split('T')[0];
const selectedClass = url.searchParams.get("classroom") || (allClasses[0]?.id || "");

// 3. Fetch Assignment & Attendance Data
let assignmentData: any[] = [];
let initialPresence: any = {};

// Use the new query that fetches by date/day
const { assignments, attendance } = await getTeacherAttendanceByDate(selectedDate);

assignmentData = assignments;

// Map existing attendance to format that component expects
attendance.forEach(a => {
    // Key should be unique for the assignment and session
    const key = `${a.teacherId}-${a.subjectId}-${a.classroomId}-${a.session}`;
    
    const statusMap: Record<string, string> = {
        'Hadir': 'H',
        'Izin': 'I',
        'Sakit': 'S',
        'Alpha': 'A'
    };
    
    initialPresence[key] = statusMap[a.status] || 'H';
});

// 4. Handle POST Actions
if (Astro.request.method === "POST") {
    try {
        const payload = await Astro.request.json();
        const { date, presenceData } = payload;

        if (activeYear[0]) {
            // presenceData is already an array of objects from the component
            const recordsToSave = presenceData.map((rec: any) => ({
                ...rec,
                academicYearId: rec.academicYearId || activeYear[0].id
            }));

            if (recordsToSave.length > 0) {
                await saveBulkTeacherAttendance(recordsToSave);
            }
            
            return new Response(JSON.stringify({ success: true }), { status: 200 });
        }
    } catch (e) {
        console.error("Error saving teacher attendance:", e);
        return new Response(JSON.stringify({ success: false }), { status: 500 });
    }
}
---

<Layout title="Keaktifan Asatidz | Raport MDT Al-Amiriyyah">
    <TeacherPresenceManagement 
        client:only="react" 
        initialAssignments={assignmentData}
        initialPresence={initialPresence}
        classrooms={allClasses}
        selectedDate={selectedDate}
        selectedClassId={selectedClass}
        user={sessionUser}
    />
</Layout>
