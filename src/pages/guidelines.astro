---
import Layout from '../layouts/Layout.astro';
import GuidelinesComponent from '../components/admin/guidelines';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/login');
const sessionUser = user as any;
---

<Layout title="Panduan Penggunaan | Raport MDT Al-Amiriyyah">
	<GuidelinesComponent client:only="react" user={sessionUser} />
</Layout>
